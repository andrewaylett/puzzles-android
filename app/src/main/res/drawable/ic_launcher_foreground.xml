<?xml version="1.0" encoding="utf-8"?>
<!--
  The upstream collection's own app icon: a montage of tiles from several of its games (Mines,
  Net, Keen, Same Game, Undead), taken from the project's Icon@2x.png/iTunesArtwork.png. Adaptive
  icons reserve the outer third of the 108dp canvas for masking on some launcher shapes, so the
  artwork is centred at the 66dp diameter that stays visible under every mask.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item
      android:width="66dp"
      android:height="66dp"
      android:gravity="center"
      android:drawable="@drawable/puzzles_icon_montage" />
</layer-list>
