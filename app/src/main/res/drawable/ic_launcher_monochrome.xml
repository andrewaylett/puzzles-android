<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only for the themed/monochrome launcher icon (Android 13+), which must be a single-colour
  silhouette — the upstream collection's own icon (see puzzles_icon_montage.png) is a full-colour
  raster montage and can't serve that purpose. This is a 3x3 grid with a few filled cells: the
  motif shared by most of the collection's puzzles, and legible at launcher size in a way a
  specific puzzle's artwork would not be.

  Adaptive icons reserve the outer third for masking, so the artwork is kept within the middle
  54dp of the 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M30,30h15v15h-15z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M63,30h15v15h-15z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M46.5,46.5h15v15h-15z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M30,63h15v15h-15z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M63,63h15v15h-15z" />
  <path
      android:strokeColor="#FFFFFF"
      android:strokeWidth="2"
      android:fillColor="#00000000"
      android:pathData="M30,30h48v48h-48z" />
</vector>
